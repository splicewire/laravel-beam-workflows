{
    "name": "splicewire/laravel-beam-workflows",
    "description": "The workflows arm of the schemastud beam family: a beam can model status. Sets the platform precedent for two seams \u2014 a normalized status projection (Display, over spatie/laravel-activitylog) and a state-machine Circuit node type (Control, over symfony/workflow) \u2014 sitting BESIDE the paid laravel-circuit-engine / laravel-composition-engine kernels without modifying either (ADR-0092, ADR-0034). Ships one shared State vocabulary + StatusEvent shape and proves both seams end-to-end on the composition lifecycle.",
    "keywords": [
        "laravel",
        "schemastud",
        "beam",
        "workflows",
        "status",
        "state-machine",
        "symfony-workflow"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Stephen Rushing",
            "email": "stephen@rushing.dev"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "rushing/laravel-popcorn": "@dev",
        "rushing/laravel-schema-convergence": "*",
        "rushing/php-popcorn": "dev-main",
        "spatie/laravel-activitylog": "^4.0|^5.0",
        "splicewire/laravel-beam": "*",
        "symfony/workflow": "^6.4|^7.0"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^9.0|^10.0",
        "pestphp/pest": "^4.0",
        "splicewire/laravel-circuit-engine": "@dev",
        "splicewire/laravel-circuit-spine": "@dev",
        "wikimedia/composer-merge-plugin": "^2.1"
    },
    "suggest": {
        "splicewire/laravel-circuit-engine": "Enables the state-machine Circuit node type (Seam B): the local `workflow.apply` capability registers into the kernel's CapabilityManifest so a state machine slots into a Circuit graph. Without it, the Display substrate (Seam A) and the DefinitionBuilder still work standalone."
    },
    "autoload": {
        "psr-4": {
            "Splicewire\\Beam\\Workflows\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Splicewire\\Beam\\Workflows\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        },
        "laravel": {
            "providers": [
                "Splicewire\\Beam\\Workflows\\BeamWorkflowsServiceProvider"
            ]
        },
        "merge-plugin": {
            "include": [
                "composer.local.json"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "test": "@php vendor/bin/pest",
        "pint": "@php -d memory_limit=512M vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "wikimedia/composer-merge-plugin": true
        }
    },
    "repositories": [
        {
            "type": "git",
            "url": "https://github.com/stephenr85/laravel-popcorn.git"
        },
        {
            "type": "git",
            "url": "https://github.com/stephenr85/laravel-schema-convergence.git"
        },
        {
            "type": "git",
            "url": "https://github.com/splicewire/laravel-beam.git"
        },
        {
            "type": "git",
            "url": "https://github.com/splicewire/laravel-circuit-engine.git"
        },
        {
            "type": "git",
            "url": "https://github.com/splicewire/laravel-circuit-spine.git"
        },
        {
            "type": "git",
            "url": "https://github.com/stephenr85/php-popcorn.git"
        },
        {
            "type": "git",
            "url": "https://github.com/stephenr85/codegen.git"
        },
        {
            "type": "git",
            "url": "https://github.com/stephenr85/laravel-doctor.git"
        },
        {
            "type": "git",
            "url": "https://github.com/stephenr85/laravel-data-filters.git"
        },
        {
            "type": "git",
            "url": "https://github.com/stephenr85/laravel-permission-cascade.git"
        },
        {
            "type": "git",
            "url": "https://github.com/stephenr85/laravel-versioning.git"
        },
        {
            "type": "git",
            "url": "https://github.com/schemastud/laravel-data-schemas.git"
        },
        {
            "type": "git",
            "url": "https://github.com/schemastud/laravel-frame.git"
        },
        {
            "type": "git",
            "url": "https://github.com/stephenr85/laravel-pipeline-registry.git"
        },
        {
            "type": "git",
            "url": "https://github.com/schemastud/laravel-json-ns.git"
        }
    ]
}
